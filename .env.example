# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL, used by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/visitor_db?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP (nodemailer). If SMTP_USER/SMTP_PASS are unset, emails fall back to the Ethereal test account.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL="SaaS Society <noreply@saassociety.com>"

# Payments (each society connects its own Stripe account in Settings)
# Encrypts the societies' Stripe keys in the database. Use a long random string and never change it later.
ENCRYPTION_KEY=
# Where the web app is served: used in emails, QR codes and Stripe return links
FRONTEND_URL=http://localhost:3000
# Public URL of this API, shown in Settings as the Stripe webhook address (defaults to the request host)
API_PUBLIC_URL=
# Set to true ONLY for local demos: lets a resident mark a bill paid without paying
ALLOW_DEMO_PAYMENTS=false
# Set to false to stop the 6-hourly autopay job
AUTOPAY_ENABLED=true

# Optional: comma-separated website addresses allowed to open the live (WebSocket) connection, e.g. https://app.example.com. Empty = any.
# CORS_ORIGIN=

# Security (see SECURITY.md). In production JWT_* must be random 32+ character strings.
# Websites allowed to call the API from a browser (comma-separated). Defaults to FRONTEND_URL; localhost is allowed only outside production.
# CORS_ORIGIN=https://app.example.com
# Show the /api-docs page in production (leave off)
# ENABLE_API_DOCS=false
# Tries per 15 minutes per address for sign-in/sign-up/refresh, and the general API limit
# AUTH_RATE_LIMIT=20
# API_RATE_LIMIT=1000
# Largest request body
# BODY_LIMIT=1mb
